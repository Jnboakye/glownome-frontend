# Copy to .env, set your Mac's LAN IP, then restart Metro: npx expo start -c
#
# NOT localhost — on a phone running Expo Go, localhost is the phone.
#   Mac LAN IP:        ipconfig getifaddr en0   ->  http://192.168.x.x:8000
#   Android emulator:  http://10.0.2.2:8000
#   iOS simulator:     http://localhost:8000    (the one case it works)
#
# EXPO_PUBLIC_ is required: Expo only inlines variables with that prefix.
EXPO_PUBLIC_API_URL=http://192.168.1.42:8000
